# Copy this file to .env.local and fill in real values yourself.
# Never commit .env.local — it's already in .gitignore.

# From a Neon Postgres database (Vercel dashboard -> your project ->
# Storage -> Create Database -> Neon, Vercel's native Postgres integration).
# Copy the "DATABASE_URL" value it gives you (or use
# `vercel env pull .env.local` once linked).
DATABASE_URL=

# From resend.com/api-keys after creating a Resend account
RESEND_API_KEY=

# Sender address. For testing you can use Resend's shared test domain:
#   onboarding@resend.dev
# To send from your own address, verify a domain in Resend first.
EMAIL_FROM=

# Where the daily digest gets sent
EMAIL_TO=jcwetzel1@gmail.com

# Any random long string — used to authenticate Vercel Cron's call to
# /api/cron/daily-digest so randoms on the internet can't trigger it.
# Vercel automatically sends this as a Bearer token to your cron routes
# once CRON_SECRET is set as an env var on the project.
CRON_SECRET=
